{
  "name": "obsidian-today-alias",
  "version": "2.0.6",
  "description": "Obsidian plugin to show today/yesterday aliases and hide date prefixes in the file explorer",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "plugin"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "esbuild": "0.17.3",
    "obsidian": "^1.13.1",
    "typescript": "4.7.4"
  }
}
